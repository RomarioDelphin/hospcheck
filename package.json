{
  "name": "hospcheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HospCheck - Gestão de equipamentos hospitalares (projeto independente, dados de demonstração)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "test:e2e": "node scripts/e2e-test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
