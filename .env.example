# ---------- HospCheck — produção ----------
# Copie para .env e ajuste. NUNCA defina HC_SEED_DEMO em produção.

PORT=3100
TZ=America/Sao_Paulo
HOSPCHECK_DB=/app/data/hospcheck.db

# Cookie de sessão só em HTTPS (ligue quando o site estiver atrás de TLS/proxy)
HOSPCHECK_FORCAR_HTTPS=1

# Nome do hospital criado no provisionamento de produção
HC_HOSPITAL_NOME=Hospital

# Acesso master criado no primeiro start (troca de senha obrigatória no 1º login)
HC_MASTER_USUARIO=romario
HC_MASTER_SENHA=romario
HC_MASTER_NOME=Romário (master)

# Resumo diário por e-mail (opcional; sem isso fica registrado como pendente, sem simulação)
HC_SMTP_URL=
HC_EMAIL_RESUMO=

# Integração Google (opcional)
GOOGLE_SERVICE_ACCOUNT_JSON=
